# ========================================================
# Supabase Configuration (VélocePass / RentTech Hub)
# ========================================================
# Renseignez ces variables d'environnement pour activer
# la persistance et l'authentification en ligne avec Supabase.
#
# Obtenez ces valeurs depuis votre tableau de bord Supabase :
# Project Settings > API > Project URL & anon/public API key.

VITE_SUPABASE_URL=https://votre-projet-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé API Google Gemini (optionnelle, gérée côté serveur pour le support client)
GEMINI_API_KEY=
