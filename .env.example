# ========================================================
# Configuration MaishaPay Mobile Money (Airtel, Vodacom, Orange)
# ========================================================
# Mode d'exécution :
# 0 = Mode Sandbox / Test (Simulation immédiate pour tester sans argent réel)
# 1 = Mode Production (Transactions réelles avec débit Mobile Money)
MAISHAPAY_MODE=0

# Clés d'API Marchand fournies par MaishaPay (dashboard marchand)
MAISHAPAY_PUBLIC_KEY=MP-LIVEPK-xxxxxxxxxxxxxxxxxxxx
MAISHAPAY_SECRET_KEY=MP-LIVEPK-xxxxxxxxxxxxxxxxxxxx

# URLs officielles des services API MaishaPay
MAISHAPAY_API_URL=https://marchand.maishapay.online/api/payment/rest/vers1.0/merchant
MAISHAPAY_CHECK_URL=https://marchand.maishapay.online/api/transaction/rest/v2/check
MAISHAPAY_CARD_URL=https://marchand.maishapay.online/api/collect/v3/store/card

# URL publique HTTPS de l'application PHP (callback MaishaPay)
APP_URL=https://example.com

# ========================================================
# Base de Données MySQL / MariaDB (PHP Backend)
# ========================================================
DB_HOST=localhost
DB_NAME=renttech_hub
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ========================================================
# Paramètres Métier Plateforme
# ========================================================
AIRTEL_OFFICIAL_NUMBER=0992611845
AIRTEL_OFFICIAL_NAME=KAMBALE
REFERRAL_COMMISSION_PERCENT=20
ADMIN_SECURITY_PIN=998844

# ========================================================
# Supabase Configuration (Optionnel pour l'interface React/Vite)
# ========================================================
VITE_SUPABASE_URL=https://votre-projet-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé API Google Gemini (Support Client IA)
GEMINI_API_KEY=
